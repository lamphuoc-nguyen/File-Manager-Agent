{
  "id": "c3d4e5f6-a7b8-4c9d-8e1f-2a3b4c5d6e7f",
  "name": "Data Analyst",
  "version": "1.0.0",
  "description": "An AI agent specialized in data analysis, SQL queries, and visualization",
  "author": "Event Platform Team",
  "tags": ["data-analysis", "sql", "python", "visualization", "postgres"],
  "category": "analysis",
  "persona": {
    "name": "Data Analyst",
    "role": "Senior Data Analyst",
    "description": "Expert in SQL, Python, data visualization, and statistical analysis",
    "instructions": "You are a senior data analyst. Help with:\n1. Writing and optimizing SQL queries\n2. Data exploration and analysis\n3. Creating visualizations\n4. Statistical analysis\n5. Data modeling\n6. ETL/ELT pipeline design\n\nAlways explain your approach and provide reproducible code.",
    "tone": "technical",
    "language": "en"
  },
  "model": {
    "provider": "anthropic",
    "model": "claude-3-5-sonnet-20241022",
    "temperature": 0.2,
    "maxTokens": 8192
  },
  "tools": [
    {
      "name": "sql_query",
      "description": "Execute SQL queries against the database",
      "type": "function",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "database": { "type": "string" }
        },
        "required": ["query"]
      },
      "enabled": true
    },
    {
      "name": "python_exec",
      "description": "Execute Python code for data analysis",
      "type": "function",
      "parameters": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "libraries": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["code"]
      },
      "enabled": true
    },
    {
      "name": "read_file",
      "description": "Read file contents",
      "type": "builtin",
      "builtinName": "read",
      "enabled": true
    }
  ],
  "skills": [
    {
      "name": "sql-optimization",
      "version": "1.0.0",
      "enabled": true
    },
    {
      "name": "python-pandas",
      "version": "1.0.0",
      "enabled": true
    },
    {
      "name": "data-visualization",
      "version": "1.0.0",
      "enabled": true
    }
  ],
  "memory": {
    "type": "hybrid",
    "maxMessages": 40,
    "maxTokens": 20000,
    "vectorStore": {
      "provider": "supabase",
      "collection": "data-analysis-knowledge",
      "embeddingModel": "text-embedding-3-small"
    }
  },
  "workflows": [],
  "timeout": 300000,
  "maxTurns": 40,
  "parallelExecution": true,
  "envVars": ["DATABASE_URL"],
  "requiredSecrets": ["DATABASE_URL", "SUPABASE_KEY"],
  "createdAt": "2026-10-23T00:00:00.000Z",
  "updatedAt": "2026-10-23T00:00:00.000Z"
}