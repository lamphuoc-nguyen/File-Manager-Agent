{
  "name": "file-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "File Manager with AI Agents - Desktop app for managing files with natural language",
  "author": "File Manager Team",
  "scripts": {
    "dev": "vite",
    "build:electron": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json",
    "build": "npm run typecheck && npm run build:electron && vite build && electron-builder",
    "build:dir": "npm run typecheck && npm run build:electron && vite build && electron-builder --dir",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && node scripts/dev.mjs",
    "start": "npm run build:electron && vite build && electron .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:electron": "npm run build:electron && node tests/electron/run.mjs",
    "icons": "electron scripts/make-icons.mjs"
  },
  "dependencies": {
    "unpdf": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.filemanager.app",
    "productName": "File Manager",
    "copyright": "Copyright © 2026 File Manager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "agents",
        "to": "agents",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "File Manager"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
